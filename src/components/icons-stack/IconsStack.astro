---
const icons = [
  { src: "ts.avif" },
  { src: "js.avif" },
  { src: "html.avif" },
  { src: "css.avif" },
  { src: "node.avif" },
  { src: "bun.avif" },
  { src: "react.avif" },
  { src: "vite.avif" },
  { src: "next.avif" },
  { src: "astro.avif" },
  { src: "tanstack.avif" },
  { src: "docker.avif" },
  { src: "azure.avif" },
  { src: "sql.avif" },
  { src: "tauri.avif" },
  { src: "rust.avif" }
];
---

<div class="icons-stack">
  {
    icons.map(({ src }) => (
      <img
        src={`/icons-stack/${src}`}
        alt={src.split(".")[0]}
        title={src.split(".")[0]}
      />
    ))
  }
</div>

<style>
  .icons-stack {
    display: grid;
    /* 4x4 */
    grid-template-columns: repeat(8, 40px);
    grid-template-rows: repeat(2, 40px);
    gap: 16px;

    @media (max-width: 810px) {
      grid-template-columns: repeat(4, 64px);
      grid-template-rows: repeat(4, 64px);
      gap: 16px;
      margin: auto;
    }
  }

  img {
    object-fit: contain;
  }
</style>
