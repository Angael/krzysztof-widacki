---
export type Project = {
  name: string;
  description: string;
  imgSrc?: string;
  tags: string[];
  href?: string;
  source?: string;
};

const projects: Project[] = [
  {
    name: "My Portfolio site",
    description: "This minimalistic site, hosted on my VPS 😊",
    tags: ["Astro", "TS"],
    imgSrc: "/projects/portfolio-site.avif",
    source: "https://github.com/Angael/krzysztof-widacki",
    href: "/"
  },
  {
    name: "Hipoteka",
    description:
      "Fast mortgage calculator app for mortgages with overpayments, summaries, charts and tables.",
    imgSrc: "/projects/hipoteka.avif",
    tags: ["Vite", "React", "TS", "Mantine"],
    source: "https://github.com/Angael/hipoteka",
    href: "https://hipoteka.widacki.me/"
  },
  {
    name: "Tauri-2-test app (WIP)",
    description: "Not yet finished Tauri x React project",
    imgSrc: "/projects/tauri-2-test.avif",
    tags: ["Tauri", "React", "TS", "Rust", "Mantine"],
    source: "https://github.com/Angael/tauri-2-test"
  },
  {
    name: "KryptoBreaker",
    description:
      "Website created to help people learn cryptographic algorithms for free and because I was lazy and wanted to cheat on my collage exams.",
    imgSrc: "/projects/kryptobreaker.avif",
    tags: ["React", "JS", "MUI"],
    source: "https://github.com/Angael/KryptoBreaker",
    href: "https://crypto.widacki.me/"
  },
  {
    name: "Cerebro (frontend)",
    description:
      "Frontend for cerebro project. Disk drive, kind of like google drive. Compresses videos and images.",
    tags: ["Next", "React", "TS", "Tanstack"],
    source: "https://github.com/Angael/cerebro-frontend"
    // href: "https://cerebro.widacki.me/"
  },
  {
    name: "Cerebro (backend)",
    description:
      "Backend for cerebro project. Disk drive, kind of like google drive. Compresses videos and images.",
    tags: ["TS", "Hono.js", "PostgreSQL"],
    source: "https://github.com/Angael/cerebro-backend"
    // href: "https://cerebro.widacki.me/"
  },
  {
    name: "PPK helper",
    description:
      'CMD project written in C, it gave me the highest grade in in on my year. It calculates Polish "Pracownicze Plany Kapitałowe" (sytem for saving money for employees) worth after n years with given circumstances.',
    tags: ["C"],
    source: "https://github.com/Angael/C_PracowniczePlanyKapitalowe"
  },
  {
    name: "FFMPEG helper",
    description:
      "Site for generating simple ffmpeg commands for cutting videos",
    tags: ["React", "JS"],
    href: "https://ffmpeg.widacki.me/"
  },
  {
    name: "Iwona Rogowska Widacka",
    description:
      "One of the first sites I ever created. It's for my mother's business and her presence online. To this day it's one of the results when searching for 'Psycholog Belgia' in Google",
    tags: ["Astro", "TS"],
    href: "https://psychologonline.be/"
  }
];
---

<section>
  <h3>Projects</h3>
  <p class="accent">I built this</p>

  <div class="project-grid">
    {
      projects.map((project) => (
        <article>
          <div class="tags">
            {project.tags.map((tag, i, arr) => (
              <span>{tag + (i !== arr.length - 1 ? "," : "")}</span>
            ))}
          </div>

          <header class="name">{project.name}</header>

          {project.imgSrc && (
            <img class="project-img" src={project.imgSrc} alt={project.name} />
          )}

          <p class="desc">{project.description}</p>

          {(project.href || project.source) && (
            <div class="links">
              {project.href && (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit
                </a>
              )}
              {project.source && (
                <a
                  href={project.source}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Repository
                </a>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .accent {
    font-size: 1.2rem; /* 12px */
    color: var(--c-primary);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-top: 16px;
  }

  article {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .name {
    font-weight: 700;
    font-size: 1.2rem;
    font-family: "Montserrat", sans-serif;
  }

  .desc {
    font-size: 0.875rem;
  }

  .project-img {
    height: 150px;
    object-fit: cover;
  }

  .tags {
    font-size: 0.875rem;
    color: var(--c-text-secondary);

    display: flex;
    gap: 4px;
    flex-wrap: wrap;

    margin-bottom: -8px;
  }

  .links {
    display: flex;
    gap: 8px;
  }
</style>
