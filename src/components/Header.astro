---
import IconsStack from "./icons-stack/IconsStack.astro";
---

<div class="header">
  <div class="left">
    <div class="title">
      <h1>Krzysztof Widacki</h1>
      <h2>Web Developer</h2>
    </div>

    <div style="margin-bottom:auto">
      <p>I build my tools using JavaScript technologies.</p>
      <p>Here you can find my projects, contact and CV!</p>
    </div>

    <IconsStack />
  </div>

  <div class="right">
    <img class="me" src="/me.webp" alt="Krzysztof Widacki" />
  </div>
</div>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    margin-top: 20svh;
  }

  .left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;

    .title {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    & h1 {
      white-space: nowrap;
      font-size: 3.2rem;
      font-weight: 700;
      font-family: "Montserrat", sans-serif;
    }

    & h2 {
      font-size: 1.2rem; /* 12px */
      color: var(--c-primary);
    }
  }

  .right {
    position: relative;
    height: 300px;
    width: 240px;

    .me {
      position: absolute;
      left: -80px;
      top: -10px;

      max-width: 400px;
      clip-path: polygon(25% 6%, 80% 3%, 79% 49%, 19% 54%);

      transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      &:hover {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      }
    }
  }
</style>
