---
import { Image } from "astro:assets";
import me from "../assets/me.webp";

const gh = "https://github.com/Angael/";
const built: [string, string, string?][] = [
  ["analytics/", "Self-hosted cookieless web analytics", gh + "analytics"],
  ["dnd-builder/", "D&D 2024 character builder and rules reference"],
  ["maquest/", "Maquest: AI writing workspace for stories and RPG campaigns, with an MCP server", gh + "maquest"],
  ["veles/", "Veles: food, recipe and workout tracker with AI food photo scanning", gh + "veles"],
  ["rpg-music/", "Tabletop RPG music player and playlist studio"],
  ["image-gen/", "Local ComfyUI image generator alternative"],
  ["syncpair/", "Two-way cloud backup desktop app (rclone bisync)", gh + "syncpair"],
  ["crypto-calc/", "Cryptography calculator that shows its work"],
  ["subtitles/", "Subtitle generator for video and audio"],
  ["media-share/", "Self-hosted media sharing platform"],
  ["hipoteka/", "Mortgage comparison calculator", gh + "hipoteka"],
  ["tab-sorter/", "Browser tab sorting extension"],
  ["annotate/", "Desktop screen annotation tool"],
];
const tools: [string, string][] = [
  ["T3 Code", "https://t3.codes"],
  ["omp", "https://github.com/can1357/oh-my-pi"],
  ["Claude Code", "https://claude.com/product/claude-code"],
  ["Codex", "https://openai.com/codex"],
  ["Hermes", "https://hermes-agent.nousresearch.com"],
];
const stack = ["TypeScript", "React", "TanStack", "Astro", "SolidJS", "Vite", "Bun/Node", "Go", "Rust", "Python", "Docker"];
const before = ["MUI", "Mantine", "TanStack Query", "Redux/Zustand", "PostgreSQL", "Hono"];
const contact = [
  ["email", "krzysztofwidacki@gmail.com", "mailto:krzysztofwidacki@gmail.com"],
  ["web", "widacki.me", "https://widacki.me"],
  ["phone", "+48 608 466 822", "tel:+48608466822"],
  ["github", "github.com/Angael", "https://github.com/Angael"],
  ["skills", "Angael/krzysztof-widacki/.agents/skills", "https://github.com/Angael/krzysztof-widacki/tree/main/.agents/skills"],
];
const ext = { target: "_blank", rel: "noopener" };
const desc = "Krzysztof Widacki currently builds and ships software he wanted to exist with AI agents.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0b0d0c" />
  <meta name="description" content={desc} />
  <link rel="icon" href="/favicon.ico" />
  <title>Krzysztof Widacki</title>
  <noscript><style>.log [data-r] { visibility: visible !important; animation: none !important; } .prompt { display: none !important; }</style></noscript>
</head>
<body>
  <div class="win">
    <header class="bar">
      <svg class="appicon" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="1.5" /><path d="M4 6l2.5 2L4 10M8 10.5h4" /></svg>
      <span class="title">krzysztof@widacki: ~</span>
      <span class="ctl" aria-hidden="true">
        <span class="btn"><svg viewBox="0 0 16 16"><path d="M4.5 6.5 8 10l3.5-3.5" /></svg></span>
        <span class="btn"><svg viewBox="0 0 16 16"><path d="M4.5 9.5 8 6l3.5 3.5" /></svg></span>
        <span class="btn close"><svg viewBox="0 0 16 16"><path d="M5 5l6 6M11 5l-6 6" /></svg></span>
      </span>
    </header>

    <main class="log" id="log">
      <div class="turn user" data-r data-k="user">
        <span class="who">&gt;</span>
        <div>
          <p class="cmd" data-type>whoami</p>
          <div class="who-out" data-r>
            <h1>Krzysztof Widacki</h1>
            <figure class="attach">
              <Image src={me} alt="Photo of Krzysztof Widacki" width={112} height={150} loading="eager" />
              <figcaption>[image #1] me.webp</figcaption>
            </figure>
          </div>
        </div>
      </div>

      <div class="turn agent" data-r data-k="text">
        <span class="who">●</span>
        <p data-s>{desc}</p>
      </div>

      <section class="turn agent" aria-labelledby="built" data-r data-k="call" data-think="Listing">
        <span class="who">●</span>
        <div class="block">
          <div class="call" data-r><span class="fn">Built</span><span class="arg">(ls ~/projects)</span></div>
          <h2 id="built" class="sr">Built</h2>
          <ul class="diff">
            {built.map(([dir, what, href]) => (
              <li data-r data-s>
                <span class="sign">+</span>
                {href ? <a class="dir" href={href} {...ext}>{dir}</a> : <span class="dir">{dir}</span>}
                <span class="what">{what}</span>
              </li>
            ))}
          </ul>
          <div class="meta" data-r>⎿ {built.length} entries</div>
        </div>
      </section>

      <section class="turn agent" aria-labelledby="tools" data-r data-k="call" data-think="Checking">
        <span class="who">●</span>
        <div class="block">
          <div class="call" data-r><span class="fn">Tools</span><span class="arg">(which agents)</span></div>
          <h2 id="tools" class="sr">Tools</h2>
          <ul class="chips">
            {tools.map(([t, href]) => <li data-r><a href={href} {...ext}>{t}</a></li>)}
          </ul>
        </div>
      </section>

      <section class="turn agent quiet" aria-labelledby="stack" data-r data-k="call" data-think="Recalling">
        <span class="who">●</span>
        <div class="block">
          <div class="call" data-r><span class="fn">Stack</span><span class="arg">(usual)</span></div>
          <h2 id="stack" class="sr">Stack</h2>
          <p class="stack" data-r data-s>{stack.join(" · ")}</p>
          <p class="stack before" data-r data-s><span class="lbl">⎿ before agents:</span> {before.join(" · ")}</p>
        </div>
      </section>

      <section class="turn agent" aria-labelledby="contact" data-r data-k="call" data-think="Reading">
        <span class="who">●</span>
        <div class="block">
          <div class="call" data-r><span class="fn">Contact</span><span class="arg">(cat contact.json)</span></div>
          <h2 id="contact" class="sr">Contact</h2>
          <dl class="kv">
            {contact.map(([k, v, href]) => (
              <div data-r data-s><dt>{k}</dt><dd><a href={href} {...(href.startsWith("http") ? ext : {})}>{v}</a></dd></div>
            ))}
          </dl>
        </div>
      </section>

      <div id="out" class="out" aria-live="polite"></div>

      <div class="prompt" data-r>
        <span class="who">&gt;</span>
        <label class="field">
          <span class="sr">Command</span>
          <span class="mirror" aria-hidden="true"><span id="pre"></span><span id="car" class="cursor"> </span><span id="post"></span></span>
          <input id="cmd" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="" />
        </label>
      </div>
    </main>

    <footer class="status">
      <span><kbd>?</kbd> for a joke<span class="wide"> · <kbd>help</kbd> for commands</span></span>
      <span class="ok"><span id="tok">0</span> tokens</span>
    </footer>
  </div>
  <script src="../scripts/term.ts"></script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0b0d0c;
    --panel: #111412;
    --bar: #181c1a;
    --line: #232925;
    --text: #d6ddd8;
    --muted: #8a958e;
    --faint: #5c665f;
    --accent: #e8a46b;
    --add: #7fd69a;
    --add-bg: #12261a;
    --link: #9cc8ff;
    --red: #da4453;
    --mono: ui-monospace, "JetBrains Mono", "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    color: var(--text);
    font: 15px/1.6 var(--mono);
    background: radial-gradient(1200px 500px at 80% -10%, #1a2a20 0%, transparent 60%), var(--bg);
    min-height: 100vh;
    padding: clamp(0px, 4vw, 48px) clamp(0px, 3vw, 32px);
    overflow-x: hidden;
  }
  @media (max-width: 600px) { body { padding: 0; } }
  a { color: var(--link); text-decoration: none; overflow-wrap: anywhere; border-radius: 2px; }
  a:hover, a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  ::selection { background: #2d4a37; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  kbd { font: inherit; color: var(--text); }

  .win {
    max-width: 880px; margin: 0 auto;
    background: var(--panel);
    border: 1px solid var(--line); border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 30px 80px -30px #000, 0 0 0 1px #000;
  }
  @media (max-width: 600px) { .win { border-radius: 0; border-inline: 0; border-top: 0; min-height: 100vh; display: flex; flex-direction: column; } .log { flex: 1; } }

  /* Breeze-ish title bar */
  .bar {
    position: relative; display: flex; align-items: center; gap: 8px;
    height: 34px; padding: 0 4px 0 10px;
    background: var(--bar); border-bottom: 1px solid var(--line);
    font-size: 12.5px; color: var(--muted); user-select: none;
  }
  .appicon { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .title { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; max-width: calc(100% - 200px); overflow: hidden; text-overflow: ellipsis; color: var(--text); }
  @media (max-width: 420px) { .title { position: static; transform: none; max-width: none; flex: 1; min-width: 0; } }
  .ctl { margin-left: auto; display: flex; gap: 2px; }
  .btn { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; transition: background-color .12s; }
  .btn svg { width: 16px; height: 16px; fill: none; stroke: var(--muted); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .btn:hover { background: #2a302c; }
  .btn:hover svg { stroke: var(--text); }
  .btn.close:hover { background: var(--red); }
  .btn.close:hover svg { stroke: #fff; }

  .log { padding: 24px 16px 14px; display: grid; gap: 24px; align-content: start; }
  @media (min-width: 640px) { .log { padding: 32px 32px 18px; gap: 26px; } }

  .turn { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 6px 10px; }
  .turn > * { min-width: 0; }
  .who { color: var(--muted); user-select: none; }
  .agent > .who { color: var(--accent); }
  .turn p { margin: 0; }

  .cmd { color: var(--text); min-height: 1.6em; }
  h1 {
    margin: 10px 0 0; font-size: clamp(30px, 8vw, 52px); line-height: 1.05;
    letter-spacing: -0.03em; font-weight: 700; color: var(--text); overflow-wrap: anywhere;
  }
  .attach { display: flex; align-items: end; gap: 10px; margin: 14px 0 0; }
  .attach img {
    width: 56px; height: 75px; object-fit: cover; object-position: 50% 20%;
    border: 1px solid var(--line); border-radius: 4px; filter: grayscale(.35) contrast(1.05);
  }
  .attach figcaption { font-size: 12px; color: var(--muted); }

  .call .fn { font-weight: 700; }
  .call .arg { color: var(--muted); }
  .meta { color: var(--muted); font-size: 13px; margin-top: 6px; }

  .diff { list-style: none; margin: 10px 0 0; padding: 0; border-left: 1px solid var(--line); }
  .diff li {
    display: grid; grid-template-columns: 22px 132px minmax(0, 1fr); gap: 8px;
    padding: 3px 12px 3px 2px; background: var(--add-bg);
    border-bottom: 1px solid var(--panel);
  }
  .diff li:hover { background: #183222; }
  .sign { color: var(--add); text-align: center; user-select: none; }
  .dir { color: var(--add); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  span.dir { opacity: .7; }
  a.dir { color: var(--add); text-decoration-color: var(--add); }
  .what { color: #e6f3ea; }
  @media (max-width: 560px) {
    .diff li { grid-template-columns: 16px minmax(0, 1fr); gap: 0 6px; padding-block: 5px; }
    .what { grid-column: 2; font-size: 14px; color: #c9dccf; }
  }

  .chips { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid var(--line); border-radius: 4px; }
  .chips a { display: block; padding: 2px 10px; color: var(--accent); }
  .chips a::before { content: "$ "; color: var(--muted); }
  .chips li:hover { border-color: #3a443d; }

  .quiet { font-size: 13.5px; }
  .stack { margin-top: 6px !important; color: var(--muted); }
  .before { color: var(--faint); }
  .lbl { color: var(--faint); }

  .kv { margin: 10px 0 0; display: grid; gap: 4px; }
  .kv div { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 8px; }
  .kv dt { color: var(--muted); }
  .kv dt::after { content: ":"; }
  .kv dd { margin: 0; }

  .out { display: grid; gap: 18px; }
  .out:empty { display: none; }
  .out .reply { font-size: 14px; }
  .out .dimtxt { color: var(--muted); }
  .out ul { list-style: none; margin: 4px 0 0; padding: 0; }
  .out .k { color: var(--accent); display: inline-block; min-width: 9ch; }

  .think { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 2px 10px; color: var(--accent); }
  .think .word { color: var(--accent); }
  .think .word::after { content: "…"; color: var(--muted); }
  .think .garble { grid-column: 2; color: var(--faint); font-size: 12.5px; font-style: italic; overflow-wrap: anywhere; }

  .prompt { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; align-items: center; padding-top: 16px; border-top: 1px dashed var(--line); color: var(--muted); }
  .field { position: relative; display: block; min-width: 0; cursor: text; }
  .mirror { display: block; white-space: pre; overflow: hidden; color: var(--text); min-height: 1.6em; }
  #cmd {
    position: absolute; inset: 0; width: 100%; margin: 0; padding: 0; border: 0; outline: 0;
    background: transparent; color: transparent; caret-color: transparent;
    font: 16px/1.6 var(--mono); /* >=16px: no iOS zoom */
  }
  .mirror, .cmd-echo { font-size: 16px; }
  .cursor { display: inline-block; min-width: 9px; background: var(--text); color: var(--panel); animation: blink 1.1s steps(1) infinite; }
  .field:focus-within { outline: none; }
  .prompt:focus-within { border-top-color: #3a443d; }
  .typing .cursor { animation: none; }

  .status { display: flex; justify-content: space-between; gap: 14px; padding: 9px 16px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); }
  @media (max-width: 420px) { .status .wide { display: none; } }
  .status .ok { color: var(--add); white-space: nowrap; }
  .status .ok::before { content: "● "; animation: pulse 2s ease-in-out infinite; }

  /* Reveal: hidden before JS runs, with a fallback in case it never does. */
  .log [data-r] { visibility: hidden; animation: fb 0s 3s forwards; }
  .run .log [data-r] { animation: none; }
  .run .log [data-r]:not(.on) { display: none; }
  .run .log [data-r].on { visibility: visible; }

  @keyframes fb { to { visibility: visible; } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes pulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) {
    .log [data-r] { visibility: visible; animation: none; }
    *, *::before { animation: none !important; transition: none !important; }
  }
</style>
