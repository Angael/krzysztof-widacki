---
import IconsStack from "./icons-stack/IconsStack.astro";
---

<div class="header">
  <div class="left">
    <div class="title">
      <h1>Krzysztof Widacki</h1>
      <h2>Web Developer</h2>
    </div>

    <div style="margin-bottom:auto">
      <p>I build apps and tools using Typescript.</p>
      <p>Here you can find my projects, contact and CV!</p>
    </div>

    <IconsStack />
  </div>

  <div class="right">
    <img class="me" src="/me.webp" alt="Krzysztof Widacki" />
  </div>
</div>

<style>
  .header {
    display: grid;
    justify-items: center;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 10svh;
  }

  @media (min-width: 810px) {
    .header {
      justify-items: flex-start;
      grid-template-columns: 1fr auto;
      margin-top: 20svh;
    }

    .right {
      order: 2;
    }
  }

  .left {
    order: 2;
  }

  @media (min-width: 810px) {
    .left {
      order: 1;
    }
  }

  .left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;

    .title {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    & h1 {
      /* white-space: nowrap; */
      font-size: 3.2rem;
      font-weight: 700;
      font-family: "Montserrat", sans-serif;

      @media (max-width: 810px) {
        font-size: 2rem;
      }
    }

    & h2 {
      font-size: 1.2rem; /* 12px */
      color: var(--c-primary);
    }
  }

  .right {
    position: relative;
    height: 300px;
    width: 240px;

    .me {
      position: absolute;
      left: -80px;
      top: -10px;

      max-width: 400px;
      clip-path: polygon(25% 6%, 80% 3%, 79% 49%, 19% 54%);

      transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);

      @media (min-width: 810px) {
        &:hover {
          clip-path: polygon(7% 4%, 100% 0, 91% 93%, 1% 95%);
        }
      }
    }
  }
</style>
